# ==========================================
# LodgeOps Backend Environment Variables
# ==========================================

# Database Configuration
# For local SQLite, use the format: sqlite:///./lodge_manager.db
DATABASE_URL=sqlite:///./lodge_manager.db

# Security & JWT Token Generation
# Generate secure keys using: openssl rand -hex 32
SECRET_KEY=your_super_secret_access_key_here
REFRESH_SECRET_KEY=your_super_secret_refresh_key_here

# Token Expiration Settings (Optional - defaults are shown)
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Debug Configuration
DEBUG=True
CORS_ORIGINS=https://lodgeops.example.com
DEV_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5500,http://localhost:63342,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:5500,http://127.0.0.1:63342,http://127.0.0.1:8000

